# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info
CONFIG_MODELS_PATH=../config_models.json

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Store the full service account JSON in this env var for Render.
# Do not commit real credentials.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional local path. If unset during local backend development, the server tries ../llm.json.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional web research provider
RESEARCH_PROVIDER=disabled
RESEARCH_API_KEY=

# x402 payment gate for NestorChat demo
# Keep false for normal local backend work. Set true to require payment before live /api/runs.
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
X402_ASSET=10458941
# Atomic USDC units, 6 decimals. 1000 = 0.001 USDC.
X402_AMOUNT=1000
X402_PAY_TO=
X402_DESCRIPTION=NestorChat premium multi-model answer
X402_RESOURCE_URL=http://localhost:8080/api/runs
X402_MAX_TIMEOUT_SECONDS=300

# Local-only bypass for backend/UI development.
# When both are set, pass header: X402-DEV-PAYMENT: dev-paid
X402_DEV_BYPASS=false
X402_DEV_BYPASS_TOKEN=dev-paid

# Real x402 payer test account for local CLI smoke tests.
# Never commit real mnemonics. Root .env is ignored.
AVM_MNEMONIC=
